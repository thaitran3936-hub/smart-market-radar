# Sao chép file này thành .env rồi điền key của bạn. KHÔNG commit file .env.
# Lấy ở developers.ssi.com.vn > Bảng điều khiển > Quản lý API Key
SSI_API_KEY=
SSI_API_SECRET=

# FastConnect v3 (production)
SSI_API_BASE=https://api.ssi.com.vn
SSI_WS_URL=wss://stream.ssi.com.vn

# Giãn cách tối thiểu giữa 2 lệnh gọi REST (giây). Chỉnh lại sau khi biết rate limit thật
# (xem header X-RATELIMIT-* trong kết quả khảo sát).
SSI_MIN_INTERVAL=1.0

DB_PATH=data/market.db
TZ_NAME=Asia/Ho_Chi_Minh

# Ngày bắt đầu tải lịch sử
HISTORY_START=2018-01-01

# Chỉ cần nếu dùng scripts/sync_db.py (tải dữ liệu từ máy chủ GitHub)
GITHUB_REPO=
GITHUB_TOKEN=
