# Sao chép file này thành .env rồi điền key của bạn. KHÔNG commit file .env.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

# Mặc định theo tài liệu SSI FastConnect Data
SSI_API_BASE=https://fc-data.ssi.com.vn/api/v2/Market
SSI_STREAM_URL=https://fc-datahub.ssi.com.vn/

# Giãn cách tối thiểu giữa 2 lệnh gọi REST (giây). Chỉnh lại sau khi biết quota thật.
SSI_MIN_INTERVAL=1.0

DB_PATH=data/market.db
TZ_NAME=Asia/Ho_Chi_Minh
